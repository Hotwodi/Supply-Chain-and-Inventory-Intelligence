<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="sci_supplier_score_view_tree" model="ir.ui.view">
            <field name="name">sci.supplier.score.view.tree</field>
            <field name="model">sci.supplier.score</field>
            <field name="arch" type="xml">
                <list string="Supplier Scores" decoration-success="risk_score &lt; 30" decoration-danger="risk_score &gt;= 70">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="on_time_rate"/>
                    <field name="quality_rate"/>
                    <field name="cost_index"/>
                    <field name="risk_score"/>
                    <field name="overall_score"/>
                    <field name="last_updated"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="sci_supplier_score_view_form" model="ir.ui.view">
            <field name="name">sci.supplier.score.view.form</field>
            <field name="model">sci.supplier.score</field>
            <field name="arch" type="xml">
                <form string="Supplier Score">
                    <header>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="on_time_rate"/>
                                <field name="quality_rate"/>
                            </group>
                            <group>
                                <field name="cost_index"/>
                                <field name="risk_score"/>
                                <field name="overall_score"/>
                                <field name="last_updated"/>
                                <field name="active" invisible="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="AI Recommendation">
                            <field name="ai_recommendation" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="sci_supplier_score_view_search" model="ir.ui.view">
            <field name="name">sci.supplier.score.view.search</field>
            <field name="model">sci.supplier.score</field>
            <field name="arch" type="xml">
                <search string="Supplier Scores">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <filter string="High Risk" name="filter_high_risk" domain="[('risk_score', '&gt;=', 70)]"/>
                    <filter string="Low Risk" name="filter_low_risk" domain="[('risk_score', '&lt;', 30)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Supplier" name="group_supplier" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="sci_supplier_score_action" model="ir.actions.act_window">
            <field name="name">Supplier Scores</field>
            <field name="res_model">sci.supplier.score</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="sci_supplier_score_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new supplier score
                </p>
            </field>
        </record>
    </data>
</odoo>
