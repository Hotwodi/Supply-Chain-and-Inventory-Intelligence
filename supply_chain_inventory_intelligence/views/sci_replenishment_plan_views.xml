<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="sci_replenishment_plan_view_tree" model="ir.ui.view">
            <field name="name">sci.replenishment.plan.view.tree</field>
            <field name="model">sci.replenishment.plan</field>
            <field name="arch" type="xml">
                <list string="Replenishment Plans" decoration-success="state == 'received'" decoration-danger="state == 'draft'">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="warehouse_id"/>
                    <field name="current_stock"/>
                    <field name="suggested_qty"/>
                    <field name="ai_optimized_qty"/>
                    <field name="lead_time"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="sci_replenishment_plan_view_form" model="ir.ui.view">
            <field name="name">sci.replenishment.plan.view.form</field>
            <field name="model">sci.replenishment.plan</field>
            <field name="arch" type="xml">
                <form string="Replenishment Plan">
                    <header>
                        <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_order" type="object" string="Mark as Ordered" class="oe_highlight" invisible="state != 'approved'"/>
                        <button name="action_receive" type="object" string="Mark as Received" class="oe_highlight" invisible="state != 'ordered'"/>
                        <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,ordered,received"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="product_id"/>
                                <field name="warehouse_id"/>
                                <field name="current_stock"/>
                                <field name="lead_time"/>
                            </group>
                            <group>
                                <field name="suggested_qty"/>
                                <field name="ai_optimized_qty"/>
                                <field name="state"/>
                                <field name="active" invisible="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="sci_replenishment_plan_view_search" model="ir.ui.view">
            <field name="name">sci.replenishment.plan.view.search</field>
            <field name="model">sci.replenishment.plan</field>
            <field name="arch" type="xml">
                <search string="Replenishment Plans">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="warehouse_id"/>
                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Ordered" name="filter_ordered" domain="[('state', '=', 'ordered')]"/>
                    <filter string="Received" name="filter_received" domain="[('state', '=', 'received')]"/>
                    <group expand="0" string="Group By">
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="sci_replenishment_plan_action" model="ir.actions.act_window">
            <field name="name">Replenishment Plans</field>
            <field name="res_model">sci.replenishment.plan</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="sci_replenishment_plan_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new replenishment plan
                </p>
            </field>
        </record>
    </data>
</odoo>
